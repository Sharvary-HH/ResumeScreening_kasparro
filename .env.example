# Copy to .env and fill in. Never commit the real .env.

# --- LLM ---------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. The defaults below use
# Google's OpenAI compatibility layer; two alternatives are shown underneath.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest

# Hugging Face Inference Providers:
#   LLM_BASE_URL=https://router.huggingface.co/v1
#   LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
#
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

# --- GitHub ------------------------------------------------------------------
# Optional but strongly recommended: without it GitHub allows only 60 requests
# per hour and most candidates come back rate_limited. With it, 5,000/hour.
GITHUB_TOKEN=

LLM_MAX_WORKERS=4
