.env
.venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
build_prompt_resume_screening.md

# Ignore cache contents, but keep the LLM cache: it is committed on purpose so a
# reviewer without an API key can replay the whole batch with --offline.
# (Negations cannot reach inside an excluded directory, hence `.cache/*`.)
.cache/*
!.cache/llm/

