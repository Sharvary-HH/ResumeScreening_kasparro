.env
.venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
build_prompt_resume_screening.md

# Ignore cache contents, but keep the LLM and GitHub caches: they are committed
# on purpose so a reviewer with no API key and no GitHub token can replay the
# whole batch with --offline and still get real scores.
# (Negations cannot reach inside an excluded directory, hence `.cache/*`.)
.cache/*
!.cache/llm/
!.cache/github/

# Generated by tests/conftest.py on each run
tests/fixtures/synthetic_resume.docx

# Candidate resumes are personal data - never committed.
resumes/*
!resumes/.gitkeep

# Working notes, not part of the deliverable
DESIGN_NOTES.md
